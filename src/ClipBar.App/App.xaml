<Application x:Class="ClipBar.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:ClipBar.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Our own window surface colour. ThemeService keeps it in sync with the active
                 theme; transient windows bind to it instead of WPF-UI's ApplicationBackgroundBrush
                 so the surface can never disagree with our text-colour overrides (the dark theme
                 used to render white text on WPF-UI's light background after a system theme
                 switch). -->
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F3F7FC" />
            <SolidColorBrush x:Key="BrandBrush" Color="#0A83F2" />
            <SolidColorBrush x:Key="BrandStrongBrush" Color="#005FB9" />
            <SolidColorBrush x:Key="LogoBackgroundBrush" Color="#005FB9" />
            <SolidColorBrush x:Key="LogoForegroundBrush" Color="#FFFFFF" />
            <!-- The title-bar mark draws the brand artwork from theme-aware parts, so the
                 high-contrast pairing (Highlight/HighlightText) keeps working: tile and the
                 "fixed" dot read on LogoBackground, board and clip on LogoForeground, and the
                 panel/lines have their own HC mappings in ThemeService. -->
            <LinearGradientBrush x:Key="LogoTileBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#2E96F7" />
                <GradientStop Offset="1" Color="#005FB9" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="LogoPanelBrush" Color="#EAF3FF" />
            <SolidColorBrush x:Key="LogoLineBrush" Color="#6FA3E8" />
            <SolidColorBrush x:Key="HistoryCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HistoryCardBorderBrush" Color="#E1EAF4" />
            <SolidColorBrush x:Key="HistoryHoverBrush" Color="#EFF6FF" />
            <SolidColorBrush x:Key="HistorySelectedBrush" Color="#E4F1FF" />
            <SolidColorBrush x:Key="HistorySelectedBorderBrush" Color="#83BDF3" />
            <SolidColorBrush x:Key="HistoryFocusBrush" Color="#005FB9" />
            <SolidColorBrush x:Key="TextBadgeBrush" Color="#E8F2FF" />
            <SolidColorBrush x:Key="ImageBadgeBrush" Color="#E3F5F1" />
            <SolidColorBrush x:Key="FileBadgeBrush" Color="#FFF3D8" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:ThumbnailSizeConverter x:Key="ThumbnailSize" />
            <converters:FilterAppearanceConverter x:Key="FilterAppearance" />

            <Style x:Key="ItemActionButton" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPointerOver}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
