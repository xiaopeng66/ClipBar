<Application x:Class="ClipBar.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:ClipBar.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Our own window surface colour. ThemeService keeps it in sync with the active
                 theme; transient windows bind to it instead of WPF-UI's ApplicationBackgroundBrush
                 so the surface can never disagree with our text-colour overrides (the dark theme
                 used to render white text on WPF-UI's light background after a system theme
                 switch). -->
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F3F3F3" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:ThumbnailSizeConverter x:Key="ThumbnailSize" />

            <Style x:Key="FilterItemStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,6,0" />
                <!-- UIA read the filter rows as "FilterOption { Label = ... }" (D-H-01). -->
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <!-- The stock WPF focus visual is a dotted rectangle: white dots on the dark
                     theme, dark dots on the light one, and on a rounded pill they land exactly
                     on the corner arcs (the user's 圆角白/黑印记). Selection and hover already
                     carry the state; keyboard focus gets a real ring below. -->
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <!-- Fill only, no stroke. A 1px stroke is drawn with anti-aliasing on
                                 the rounded corners, and its brush follows the theme (white-ish in
                                 dark, black-ish in light), which showed up as light or dark
                                 specks on the arcs; a keyboard-focus ring made it a full white
                                 outline. The settings window's WPF-UI buttons never had this
                                 because they carry no custom stroke either. -->
                            <Border x:Name="Pill"
                                    Padding="12,5"
                                    CornerRadius="6"
                                    BorderThickness="0"
                                    Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pill" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Pill" Property="Background"
                                            Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ItemActionButton" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background"
                                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPointerOver}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
