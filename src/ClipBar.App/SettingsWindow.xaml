<Window x:Class="ClipBar.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ClipBar 设置"
                 Width="560"
                 Height="660"
                 MinWidth="560"
                 MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 WindowStyle="None"
                 ResizeMode="CanResize"
                 Background="{DynamicResource AppSurfaceBrush}"
                 Topmost="True"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontSize="13"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextRenderingMode="ClearType"
                 UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <!-- Slim overlay scrollbar: the stock WPF one is a chunky grey column with arrow
             buttons that reads as a separate widget next to the Mica window. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="1,0,1,0"
                                                        CornerRadius="3"
                                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                        Opacity="0.6" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Width" Value="12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="Transparent"
                MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown">
            <Grid Height="34">
                <TextBlock Text="ClipBar 设置"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Button Width="40"
                        Height="28"
                        HorizontalAlignment="Right"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Click="Close_Click"
                        AutomationProperties.Name="关闭" />
            </Grid>
        </Border>

        <!-- Content keeps a 24px inset while the slim scrollbar sits in its own 8px band
             just inside the window edge, so it no longer floats detached at the far right. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="24,0,8,0"
                      Padding="0,0,16,0">
            <StackPanel>
                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="HotkeyBox" AutomationProperties.Name="快捷键" Height="34" VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="历史" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最多保存（非固定）" VerticalAlignment="Center" />
                        <TextBox x:Name="MaxItemsBox" AutomationProperties.Name="最多保存条数" Grid.Column="1" Margin="12,0,0,0" Height="34"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="固定项不参与淘汰，范围 10–5000" />
                    </Grid>
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主题" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeBox" AutomationProperties.Name="主题" Grid.Column="1" Margin="12,0,0,0" Height="34"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="图片预览" VerticalAlignment="Center" />
                        <ComboBox x:Name="ImagePreviewBox" AutomationProperties.Name="图片预览" Grid.Column="1" Margin="12,0,0,0" Height="34"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="大（自适应）" Tag="Large" />
                            <ComboBoxItem Content="中（160×120）" Tag="Medium" />
                            <ComboBoxItem Content="小（左侧图标）" Tag="Small" />
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="行为" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="面板位置" VerticalAlignment="Center" />
                        <ComboBox x:Name="PanelPositionBox" AutomationProperties.Name="面板位置"
                                  Grid.Column="1"
                                  Margin="12,0,0,0"
                                  Height="34"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="记住上次位置" Tag="Remember" />
                            <ComboBoxItem Content="鼠标所在显示器居中" Tag="MonitorCenter" />
                            <ComboBoxItem Content="跟随鼠标指针（智能展开）" Tag="CursorAnchor" />
                        </ComboBox>
                    </Grid>
                    <CheckBox x:Name="PasteOnClickCheck" Content="点击条目后自动粘贴到之前的窗口" Margin="0,0,0,8" />
                    <CheckBox x:Name="KeepPanelOpenCheck" Content="粘贴后保持面板打开（便于连续粘贴）" Margin="0,0,0,8" />
                    <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动" Margin="0,0,0,8" />
                    <CheckBox x:Name="AutoCheckUpdatesCheck"
                              Content="启动时自动检查更新"
                              AutomationProperties.Name="自动检查更新"
                              Margin="0,0,0,8" />
                    <CheckBox x:Name="CaptureImagesCheck" Content="记录图片" Margin="0,0,0,8" />
                    <CheckBox x:Name="CaptureFilesCheck" Content="记录文件列表" Margin="0,0,0,8" />
                    <CheckBox x:Name="CaptureHtmlCheck" Content="保留富文本 HTML 格式" Margin="0,0,0,14" />

                    <TextBlock Text="原生浮动剪贴板"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="按住左键不动或拖选文字后，在指针旁显示 ClipBar 的浮动按钮，悬停展开剪贴板列表。"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <CheckBox x:Name="NativeFloatingCheck" Content="启用原生浮动剪贴板" Margin="0,0,0,8" />
                    <CheckBox x:Name="InvokeOnDragCheck" Content="拖选文字后也显示浮动按钮（快速打开剪贴板列表）" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="长按触发时长" VerticalAlignment="Center" />
                        <TextBox x:Name="HoldDurationBox"
                                 AutomationProperties.Name="长按触发时长"
                                 Grid.Column="1"
                                 Margin="12,0,0,0"
                                 Height="34"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="毫秒，范围 200–2000，默认 600" />
                    </Grid>
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="排除的应用" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="ExcludedAppsBox" AutomationProperties.Name="排除的应用"
                             Height="96"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="右键菜单动作" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="BingSearchCheck"
                              Content="显示「用 Bing 搜索」（仅文本条目）"
                              Margin="0,0,0,6" />
                    <TextBlock Text="关闭后，右键文本条目不再显示这项。"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer. No success message any more: it used to share the single row with the five
             buttons, so it ellipsised to "已应用，设置立即..." and read as clipped UI. Validation
             failures still need to be visible, so they get their own full-width row above the
             buttons where nothing can overlap them. -->
        <Grid Grid.Row="2" Margin="24,14,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="StatusText"
                       Margin="0,0,0,10"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="Collapsed" />

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="打开数据目录" Click="OpenData_Click" Margin="0,0,8,0" />
                <Button Content="清空全部历史" Click="Clear_Click" Margin="0,0,8,0" />
                <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="SaveButton"
                           Content="保存"
                           Appearance="Primary"
                           Click="Save_Click"
                           Margin="0,0,8,0" />
                <!-- Filled while there are unapplied edits, back to the plain outline once they
                     are applied; see UpdateApplyButton in the code-behind. -->
                <ui:Button x:Name="ApplyButton"
                           Content="应用"
                           Appearance="Secondary"
                           Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
