<ui:FluentWindow x:Class="ClipBar.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="ClipBar 设置"
                 Width="560"
                 Height="660"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 Background="{DynamicResource AppSurfaceBrush}"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Topmost="True"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontSize="13"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextRenderingMode="ClearType"
                 UseLayoutRounding="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <!-- Slim overlay scrollbar: the stock WPF one is a chunky grey column with arrow
             buttons that reads as a separate widget next to the Mica window. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="1,0,1,0"
                                                        CornerRadius="3"
                                                        Background="{DynamicResource ControlStrongFillColorDefaultBrush}"
                                                        Opacity="0.6" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Width" Value="12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ClipBar 设置" ShowMinimize="False" ShowMaximize="False" />

        <!-- Content keeps a 24px inset while the slim scrollbar sits in its own 8px band
             just inside the window edge, so it no longer floats detached at the far right. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="24,0,8,0"
                      Padding="0,0,16,0">
            <StackPanel>
                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="HotkeyBox" AutomationProperties.Name="快捷键" Height="34" VerticalContentAlignment="Center" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="格式示例：Win+Shift+V、Ctrl+Alt+V。Win+V 被 Windows 系统占用，普通程序无法注册；如果这里填的组合已被别的软件占用，保存时会提示。" />
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="历史" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最多保存（非固定）" VerticalAlignment="Center" />
                        <TextBox x:Name="MaxItemsBox" AutomationProperties.Name="最多保存条数" Grid.Column="1" Margin="12,0,0,0" Height="34"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="固定项不参与淘汰，范围 10–5000" />
                    </Grid>
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主题" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeBox" AutomationProperties.Name="主题" Grid.Column="1" Margin="12,0,0,0" Height="34"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="跟随系统" Tag="System" />
                            <ComboBoxItem Content="浅色" Tag="Light" />
                            <ComboBoxItem Content="深色" Tag="Dark" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="跟随鼠标指针：唤出时按指针周围的剩余空间自动选择展开方向；无论哪种方式，尺寸始终记忆。" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="图片预览" VerticalAlignment="Center" />
                        <ComboBox x:Name="ImagePreviewBox" AutomationProperties.Name="图片预览" Grid.Column="1" Margin="12,0,0,0" Height="34"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="大（自适应）" Tag="Large" />
                            <ComboBoxItem Content="中（160×120）" Tag="Medium" />
                            <ComboBoxItem Content="小（左侧图标）" Tag="Small" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="跟随鼠标指针：唤出时按指针周围的剩余空间自动选择展开方向；无论哪种方式，尺寸始终记忆。" />
                    <TextBlock Text="大/中等比显示完整图片，指针停在图上时提示尺寸、来源和时间；小把缩略图放进左侧图标位，常驻显示这些信息。"
                               Style="{StaticResource Hint}" />
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="行为" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="面板位置" VerticalAlignment="Center" />
                        <ComboBox x:Name="PanelPositionBox" AutomationProperties.Name="面板位置"
                                  Grid.Column="1"
                                  Margin="12,0,0,0"
                                  Height="34"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="记住上次位置" Tag="Remember" />
                            <ComboBoxItem Content="鼠标所在显示器居中" Tag="MonitorCenter" />
                            <ComboBoxItem Content="跟随鼠标指针（智能展开）" Tag="CursorAnchor" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="跟随鼠标指针：唤出时按指针周围的剩余空间自动选择展开方向；无论哪种方式，尺寸始终记忆。" />
                    <CheckBox x:Name="PasteOnClickCheck" Content="点击条目后自动粘贴到之前的窗口" Margin="0,0,0,8" />
                    <CheckBox x:Name="KeepPanelOpenCheck" Content="粘贴后保持面板打开（便于连续粘贴）" Margin="0,0,0,8" />
                    <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动" Margin="0,0,0,8" />
                    <CheckBox x:Name="CaptureImagesCheck" Content="记录图片" Margin="0,0,0,8" />
                    <CheckBox x:Name="CaptureFilesCheck" Content="记录文件列表" Margin="0,0,0,8" />
                    <CheckBox x:Name="CaptureHtmlCheck" Content="保留富文本 HTML 格式" />
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="排除的应用" Style="{StaticResource SectionTitle}" />
                    <TextBox x:Name="ExcludedAppsBox" AutomationProperties.Name="排除的应用"
                             Height="96"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="每行一个进程名，例如 1Password.exe。这些程序复制的内容不会被记录。" />
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="把 ClipBar 装进 SnipDo" Style="{StaticResource SectionTitle}" />
                    <TextBlock Margin="0,0,0,10"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="在任意输入框里长按鼠标左键，SnipDo 会弹出剪贴板栏；点其中的「剪贴板」直接打开本应用的历史面板，用它替换 SnipDo 自带的 10 条剪贴板。" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="安装到 SnipDo" Appearance="Primary" Click="InstallToSnipDo_Click" Margin="0,0,8,0" />
                        <Button Content="导出 .pbar" Click="ExportPlugin_Click" Margin="0,0,8,0" />
                        <Button Content="打开导出目录" Click="OpenPluginDirectory_Click" />
                    </StackPanel>

                    <TextBlock x:Name="PluginStatus"
                               Margin="0,8,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <StackPanel Style="{StaticResource Section}">
                    <TextBlock Text="导入的 SnipDo 扩展" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ExtensionSummary"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="导入 .pbar" Click="ImportExtension_Click" Margin="0,0,8,0" />
                            <Button Content="导入目录" Click="ImportFolder_Click" Margin="0,0,8,0" />
                            <Button Content="打开目录" Click="OpenExtensions_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,10,0,0"
                            CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="10">
                        <StackPanel>
                            <ListBox x:Name="ExtensionList"
                                     Height="150"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="移除"
                                                    Click="RemoveExtension_Click"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ExtensionEmpty"
                                       Text="还没有导入扩展。把 SnipDo 里的 .pbar 包或扩展目录加进来，在面板里右键条目即可使用它们的动作。"
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Hint}"
                               Text="兼容 SnipDo 扩展格式：URL、PowerShell 脚本、按键组合、{PANTHERBAR_*} / {URLENCODED_TEXT} 等占位符、requirements/regex、noShowApps/showOnlyApps 和 after 行为。" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer. No success message any more: it used to share the single row with the five
             buttons, so it ellipsised to "已应用，设置立即..." and read as clipped UI. Validation
             failures still need to be visible, so they get their own full-width row above the
             buttons where nothing can overlap them. -->
        <Grid Grid.Row="2" Margin="24,14,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="StatusText"
                       Margin="0,0,0,10"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="Collapsed" />

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="打开数据目录" Click="OpenData_Click" Margin="0,0,8,0" />
                <Button Content="清空全部历史" Click="Clear_Click" Margin="0,0,8,0" />
                <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="SaveButton"
                           Content="保存"
                           Appearance="Primary"
                           Click="Save_Click"
                           Margin="0,0,8,0" />
                <!-- Filled while there are unapplied edits, back to the plain outline once they
                     are applied; see UpdateApplyButton in the code-behind. -->
                <ui:Button x:Name="ApplyButton"
                           Content="应用"
                           Appearance="Secondary"
                           Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
