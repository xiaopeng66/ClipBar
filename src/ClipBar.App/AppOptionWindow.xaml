<ui:FluentWindow x:Class="ClipBar.App.AppOptionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="选择参数"
                 Width="380"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 Background="{DynamicResource AppSurfaceBrush}"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 ResizeMode="NoResize"
                 Topmost="True"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontSize="13"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextRenderingMode="ClearType"
                 UseLayoutRounding="True">
    <Grid>
        <!-- Same layered surface as the panel/dialogs: without the app-theme background this
             window rendered the raw Mica backdrop, which follows the SYSTEM theme — a light-theme
             app showed a dark options window (D-A-03). -->
        <Border CornerRadius="8"
                Background="{DynamicResource AppSurfaceBrush}"
                Opacity="0.92" />
        <Border CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:TitleBar Grid.Row="0" Title="选择参数" ShowMinimize="False" ShowMaximize="False" />

                <Grid Grid.Row="1" Margin="20,4,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="HintText"
                               Grid.Row="0"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- F-09: many options used to grow the window past the work area, pushing
                         later selectors and the 运行/取消 buttons off-screen. The selector area
                         scrolls inside a cap; the hint and the buttons always stay visible. -->
                    <ScrollViewer x:Name="OptionScroll"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="OptionPanel" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <!-- IsCancel: Esc must cancel this modal prompt instead of trapping it (D-C-03). -->
                        <Button Content="取消" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" />
                        <ui:Button Content="运行" Appearance="Primary" IsDefault="True" Click="Run_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
