<Window x:Class="ClipBar.App.FloatingActionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipBar"
        Width="30"
        Height="30"
        MinWidth="0"
        MinHeight="0"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- No window surface and no frame: the bar is just the app logo. A light surface behind
         the icon read as a white border around it.
         The mark is 22 DIP — the size it had inside the bordered version — so it keeps the
         weight the user approved. The 30 DIP button adds only the click halo around it.
         Drawn as geometry so the clipboard's thin rules stay crisp at every display scale. -->
    <Grid>
        <Button x:Name="ClipboardButton"
                Width="30"
                Height="30"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Focusable="False"
                AutomationProperties.Name="ClipBar 浮动按钮"
                Click="ClipboardButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Hover"
                                CornerRadius="7"
                                Background="Transparent" />
                        <Viewbox Width="22" Height="22">
                            <Grid Width="256" Height="256">
                                <!-- The app mark's blue tile, exactly the source artwork's colours. -->
                                <Rectangle RadiusX="56" RadiusY="56">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#2E96F7" />
                                            <GradientStop Offset="1" Color="#005FB9" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- Soft top-left highlight of the refreshed artwork. -->
                                <Ellipse Margin="14,16,0,0"
                                         Width="144" Height="68"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Fill="White" Opacity="0.12" />
                                <!-- The clip at the top of the clipboard. -->
                                <Rectangle Margin="100,32,0,0"
                                           Width="56" Height="38"
                                           RadiusX="15" RadiusY="15"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Fill="White" />
                                <Rectangle Margin="68,50,0,0"
                                           Width="120" Height="164"
                                           RadiusX="20" RadiusY="20"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Fill="White" />
                                <Rectangle Margin="112,30,0,0"
                                           Width="32" Height="18"
                                           RadiusX="9" RadiusY="9"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Fill="#005FB9" />
                                <Rectangle Margin="86,76,0,0"
                                           Width="84" Height="120"
                                           RadiusX="14" RadiusY="14"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Fill="#EAF3FF" />
                                <Rectangle Margin="100,94,0,0"
                                           Width="56" Height="10"
                                           RadiusX="5" RadiusY="5"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Fill="#6FA3E8" />
                                <Rectangle Margin="100,118,0,0"
                                           Width="56" Height="10"
                                           RadiusX="5" RadiusY="5"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Fill="#6FA3E8" />
                                <Rectangle Margin="100,142,0,0"
                                           Width="38" Height="10"
                                           RadiusX="5" RadiusY="5"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Fill="#6FA3E8" />
                                <!-- The "pinned" dot that closes the third line. -->
                                <Ellipse Margin="144,140,0,0"
                                         Width="14" Height="14"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Fill="#005FB9" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="#22FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
