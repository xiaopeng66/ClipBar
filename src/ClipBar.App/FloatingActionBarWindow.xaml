<Window x:Class="ClipBar.App.FloatingActionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ClipBar"
        Width="46"
        Height="42"
        MinWidth="0"
        MinHeight="0"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource AppSurfaceBrush}"
        AllowsTransparency="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="Root">
        <Border CornerRadius="8"
                Background="{DynamicResource AppSurfaceBrush}"
                Opacity="{DynamicResource SurfaceLayerOpacity}" />
        <Border CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                Padding="4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ClipboardButton"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="剪贴板历史"
                        AutomationProperties.Name="剪贴板历史"
                        Click="ClipboardButton_Click">
                    <ui:SymbolIcon Symbol="Clipboard24"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
