<Window x:Class="ClipBar.App.FloatingActionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ClipBar"
        Width="40"
        Height="36"
        MinWidth="0"
        MinHeight="0"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource AppSurfaceBrush}"
        AllowsTransparency="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="Root">
        <Border CornerRadius="8"
                Background="{DynamicResource AppSurfaceBrush}"
                Opacity="{DynamicResource SurfaceLayerOpacity}" />
        <Border CornerRadius="7"
                BorderThickness="1"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                Padding="2">
            <StackPanel Orientation="Horizontal">
                <!-- The ClipBar logo (the same mark the SnipDo action ships with), not a generic
                     clipboard glyph, and no tooltip: the bar is a single obvious button. -->
                <Button x:Name="ClipboardButton"
                        Width="32"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Focusable="False"
                        AutomationProperties.Name="ClipBar 浮动按钮"
                        Click="ClipboardButton_Click">
                    <Image Source="pack://application:,,,/Assets/app.png"
                           Width="22"
                           Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
