<Window x:Class="ClipBar.App.TrayMenuWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 Title="ClipBar"
                 Width="176"
                 MinWidth="0"
                 MinHeight="0"
                 SizeToContent="Manual"
                 WindowStartupLocation="Manual"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 Background="{DynamicResource AppSurfaceBrush}"
                 AllowsTransparency="False"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontSize="12"
                 TextOptions.TextFormattingMode="Ideal"
                 TextOptions.TextRenderingMode="ClearType"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 Deactivated="Window_Deactivated"
                 PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="TrayMenuItem" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <!-- Keyboard-only focus ring (WPF shows this for keyboard focus, not mouse):
                         a row must never look "selected" before the user selects it. -->
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource SystemAccentColorBrush}"
                                            Opacity="0.8" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover/pressed only for an enabled row: the disabled "no actions"
                                 placeholder used to light up on hover and read as clickable (G-17). -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Border CornerRadius="8"
                Background="{DynamicResource AppSurfaceBrush}"
                Opacity="{DynamicResource SurfaceLayerOpacity}" />
        <Border CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                Padding="3,4,3,4">
            <!-- F-08: a long action/source list used to push its bottom rows off-screen with no
                 way to reach them. The menu is capped at the monitor work area and scrolls;
                 keyboard focus still walks the rows and brings them into view. -->
            <ScrollViewer x:Name="MenuScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MenuPanel" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
