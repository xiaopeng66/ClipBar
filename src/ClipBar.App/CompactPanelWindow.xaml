<Window x:Class="ClipBar.App.CompactPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ClipBar"
        Width="300"
        MinWidth="0"
        MinHeight="0"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource AppSurfaceBrush}"
        AllowsTransparency="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="12"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Compact row: one line of content, pastes on click. No source/time line and no
             tooltip: the list is a picker, and the extra text made each row twice as tall. -->
        <Style x:Key="CompactRow" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="3,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="6"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A ListBox container with no visuals of its own: the row template draws everything
             and the virtualising panel needs a ListBox (ItemsControl does not virtualise). -->
        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable"
                    Value="{Binding KeyboardSelectionEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBackground" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowBackground" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Border CornerRadius="8"
                Background="{DynamicResource AppSurfaceBrush}"
                Opacity="{DynamicResource SurfaceLayerOpacity}" />
        <Border CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
            <!-- A Grid (not a DockPanel): every child stretches to the full width, so the rows
                 and the footer fill the popup instead of shrinking to their content. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="EmptyText"
                           Grid.Row="0"
                           Text="还没有剪贴板记录"
                           Margin="12,12,12,8"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <!-- Virtualised: only the rows in view are ever built. Building every row as
                     real WPF elements measured ~200 ms per 60 rows, so a 400-clip history spent
                     1.2 s on the UI thread while the list was already on screen — that was the
                     stutter when hovering the logo. -->
                <!-- No ScrollViewer wrapper: a ListBox brings its own, and the nested pair
                     measured the rows with an unbounded width (text was clipped instead of
                     trimmed) and drove virtualisation through the wrong scroll host. -->
                <ListBox x:Name="RowList"
                         Grid.Row="1"
                         Margin="0,4,0,4"
                         MaxHeight="420"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="{Binding KeyboardSelectionEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource RowContainer}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Separator on the row's top edge, not its bottom: a line under a
                                     row only makes sense when another row follows, and the row at
                                     the viewport's bottom edge has none. Drawn that way, the panel
                                     never ends on a stray hairline that reads as a clipped row. The
                                     very first row skips it so the card's top edge stays clean.
                                     Opacity rather than Visibility so the row height never changes. -->
                                <Border Height="1"
                                        Margin="10,0,10,0"
                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                    <Setter Property="Opacity" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- AutomationProperties.Name is explicit: the content is
                                     a Grid, so WPF cannot derive a name from it and the row
                                     would be announced (and found by UIA) as unnamed. -->
                                <!-- Focusable=False: a mouse-down on the row must not move the
                                     Win32 focus here. Focusing would strip the target app's in-place
                                     rename edit of focus, which commits (cancels) the rename before
                                     the paste could fill it (measured on the desktop). -->
                                <Button Style="{StaticResource CompactRow}"
                                        Focusable="False"
                                        Click="Row_Click"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Width="28"
                                               Height="28"
                                               Margin="0,0,8,0"
                                               Stretch="UniformToFill"
                                               Source="{Binding Thumbnail}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <ui:SymbolIcon Grid.Column="0"
                                                       Symbol="{Binding Glyph}"
                                                       FontSize="15"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Padding="10,5">
                    <TextBlock x:Name="FooterText"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
